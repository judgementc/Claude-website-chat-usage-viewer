{
  "manifest_version": 3,
  "name": "Claude Usage Monitor",
  "version": "2.0",
  "description": "Monitor Claude plan usage, extra usage spending, and billing in real-time",
  "permissions": ["cookies", "storage", "tabs", "scripting"],
  "host_permissions": ["https://claude.ai/*"],
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icon16.png",
      "48": "icon48.png",
      "128": "icon128.png"
    }
  },
  "icons": {
    "16": "icon16.png",
    "48": "icon48.png",
    "128": "icon128.png"
  }
}
